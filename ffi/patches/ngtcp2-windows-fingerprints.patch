+
+void test_ngtcp2_conn_set_initial_pkt_num(void) {
+  ngtcp2_conn *conn;
+  uint8_t buf[1200];
+  ngtcp2_ssize written;
+
+  setup_handshake_client(&conn);
+  assert_int(NGTCP2_ERR_INVALID_ARGUMENT, ==,
+             ngtcp2_conn_set_initial_pkt_num(conn, UINT32_MAX));
+  assert_int(0, ==, ngtcp2_conn_set_initial_pkt_num(conn, 1024));
+  assert_int64(1023, ==, conn->in_pktns->tx.last_pkt_num);
+  assert_int64(1024, ==, conn->in_pktns->rtb.cc_pkt_num);
+  assert_int64(-1, ==, conn->hs_pktns->tx.last_pkt_num);
+  assert_int64(-1, ==, conn->pktns.tx.last_pkt_num);
+  written = ngtcp2_conn_write_pkt(conn, NULL, NULL, buf, sizeof(buf), 1);
+  assert_ssize(0, <, written);
+  assert_int(NGTCP2_ERR_INVALID_ARGUMENT, ==,
+             ngtcp2_conn_set_initial_pkt_num(conn, 1));
+  ngtcp2_conn_del(conn);
+}
