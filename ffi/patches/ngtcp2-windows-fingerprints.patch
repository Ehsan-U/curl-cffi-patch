+
+int ngtcp2_conn_set_initial_pkt_num(ngtcp2_conn *conn, uint32_t number) {
+  ngtcp2_pktns *pktns = conn->in_pktns;
+  if (!pktns || conn->state != NGTCP2_CS_CLIENT_INITIAL || number > INT32_MAX ||
+      pktns->tx.last_pkt_num != (int64_t)pktns->initial_pkt_num - 1)
+    return NGTCP2_ERR_INVALID_ARGUMENT;
+  pktns->initial_pkt_num = number;
+  pktns->tx.last_pkt_num = (int64_t)number - 1;
+  pktns->rtb.cc_pkt_num = number;
+  return 0;
 }
 
